{
  "client_id": "bulbashenko-site",
  "client_name": "bulbashenko.com admin",
  "client_secret": "${OIDC_SITE_CLIENT_SECRET}",
  "token_endpoint_auth_method": "client_secret_basic",
  "grant_types": [
    "authorization_code"
  ],
  "response_types": [
    "code"
  ],
  "scope": "openid profile email groups",
  "redirect_uris": [
    "https://bulbashenko.com/api/auth/oidc/callback",
    "http://localhost:3000/api/auth/oidc/callback"
  ],
  "skip_consent": true,
  "post_logout_redirect_uris": [
    "https://bulbashenko.com/",
    "http://localhost:3000/"
  ],
  "backchannel_logout_uri": "https://bulbashenko.com/api/auth/oidc/backchannel-logout",
  "backchannel_logout_session_required": true,
  "metadata": {
    "required_group": "site-admins"
  }
}
